# Frontend configuration. Vite only exposes variables prefixed with VITE_.
# Copy to client/.env.local for local development.

# Base URL of the Quorum API. Leave empty to use the origin the app is served
# from, which is the normal case behind a single reverse proxy.
VITE_API_BASE_URL=

# Authentication needs no configuration of its own: the app signs in against
# /api/auth on the API above.
