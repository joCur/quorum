# Frontend configuration. Vite only exposes variables prefixed with VITE_.
# Copy to client/.env.local for local development.

# Base URL of the Quorum API. Leave empty to use the origin the app is served
# from, which is the normal case behind a single reverse proxy.
VITE_API_BASE_URL=

# OIDC issuer of the Keycloak realm, reachable from the browser. Leave EMPTY to use the origin
# the app is served from, with the realm under VITE_OIDC_ISSUER_PATH — which is how the published
# client image is built, because the release stack puts the app, the API and Keycloak on one
# origin. Set it explicitly when Keycloak is on a different host, as it is in development.
VITE_OIDC_ISSUER_URL=http://localhost:8081/realms/quorum
# Path of the realm when the issuer is same-origin. Only used when the URL above is empty.
# VITE_OIDC_ISSUER_PATH=/realms/quorum
VITE_OIDC_CLIENT_ID=quorum-pwa
VITE_OIDC_SCOPE=openid profile email
