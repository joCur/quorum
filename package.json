{
  "name": "quorum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quorum — self-hosted meeting recording, transcription and configurable summaries.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --build --force",
    "dev:client": "pnpm --filter @quorum/client dev",
    "test": "vitest run",
    "build": "pnpm --recursive --if-present run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "node e2e/scripts/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
