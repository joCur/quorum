{
  "name": "@quorum/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quorum job worker — consumes transcribe jobs, calls the OpenAI-compatible Whisper endpoint and persists transcripts.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db-schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@prometheus-io/client": "^0.16.1",
    "@quorum/shared": "workspace:*",
    "pg-boss": "^12.28.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
