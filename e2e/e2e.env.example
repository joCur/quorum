# Template for the end-to-end stack's environment. `pnpm run e2e` copies it to `e2e/e2e.env` on
# the first run; that copy is gitignored, so a machine-local port change never shows up in a diff.
#
# Non-secret configuration only. The passwords and the storage encryption key are generated on the
# first run and kept in `e2e/.stack.env`, which is gitignored: a test stack needs no fixed
# credentials, and committing throwaway ones only trains everyone to ignore secret scanners.
#
# The suite is deliberately self-contained: it does not read the developer's `.env`, so a run
# behaves the same on a laptop and on a CI runner.

# ---- Ports ----
# There are none here on purpose. Every host port — the published container ports and the PWA, the
# mock backend and the worker's metrics endpoint on the host — is taken from the free/ephemeral
# range when the run starts, so a run never fights a development or demo stack, and two runs never
# fight each other. `scripts/run.mjs` passes the chosen ports to compose through the environment,
# which outranks this file: a port set here would be ignored.
#
# To pin one anyway — a predictable URL while debugging — export it for the run:
#   CLIENT_PORT=4173 pnpm run e2e
# A pinned port that something else already holds fails the run and names the holder.

# ---- Infrastructure ----
POSTGRES_USER=quorum
POSTGRES_DB=quorum
MINIO_ROOT_USER=quorum-e2e
S3_BUCKET=recordings
S3_SSE=AES256

# ---- Whisper ----
# CPU image with the smallest model. Only the real-Whisper variant of the suite starts this
# service; the default run points the worker at a mock transcription endpoint instead.
WHISPER_IMAGE_TAG=latest-cpu
WHISPER_MODEL=Systran/faster-whisper-tiny
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# ---- Auth ----
KEYCLOAK_VERSION=26.5
KEYCLOAK_ADMIN=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
# KEYCLOAK_PUBLIC_URL and OIDC_PUBLIC_ISSUER_URL are not set here: both carry Keycloak's host
# port, which the run picks, so the run exports them itself.
OIDC_ISSUER_URL=http://keycloak:8080/realms/quorum
OIDC_CLIENT_ID=quorum-pwa
OIDC_AUDIENCE=quorum-api
OIDC_TENANT_CLAIM=tenant_id

# ---- Server ----
RECORDING_ALLOW_HEADER_AUTH=false
LOG_LEVEL=warn

# ---- Summary backend ----
# Unused by the suite; declared because the base compose file references it.
SUMMARY_BASE_URL=http://localhost:9/v1
SUMMARY_API_KEY=unused-by-the-suite
SUMMARY_MODEL=unused
