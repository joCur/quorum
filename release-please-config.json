{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "packages": {
    ".": {
      "release-type": "node",
      "component": "",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "client/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "server/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "worker/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "shared/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "e2e/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
