# --- Secrets & Konfiguration ---
.env
.env.*
!.env.example
# The end-to-end stack's local environment and generated credentials. The template committed
# next to them is e2e/e2e.env.example; nothing env-shaped is ever tracked.
e2e/e2e.env
e2e/.stack.env
# The host ports a run took, remembered per compose project so the reuse loop finds its stack.
e2e/.ports.*.json

# --- Dependencies ---
node_modules/
.pnp.*
.yarn/

# --- Build-Output ---
dist/
build/
out/
*.tsbuildinfo
coverage/

# --- Runtime & Daten (lokale Docker-Volumes, falls gemountet) ---
data/
*.log
logs/

# --- Modelle & Audio (groß, gehören nicht ins Repo) ---
models/
*.bin
*.gguf
*.wav
*.webm
*.ogg
*.opus
*.mp3
*.m4a

# --- OS & Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Test-Artefakte ---
playwright-report/
test-results/
.nyc_output/

# Design snapshots handed over for a ticket; not part of the build.
.design-ref/
