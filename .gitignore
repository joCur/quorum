# --- Secrets & Konfiguration ---
.env
.env.*
!.env.example
# The end-to-end stack's local environment and generated credentials. The template committed
# next to them is e2e/e2e.env.example; nothing env-shaped is ever tracked.
e2e/e2e.env
e2e/.stack.env
# The host ports a run took, remembered per compose project so the reuse loop finds its stack.
e2e/.ports.*.json

# --- Dependencies ---
node_modules/
.pnp.*
.yarn/

# --- Build-Output ---
dist/
build/
out/
*.tsbuildinfo
coverage/

# --- Runtime & data (local Docker volumes, if mounted) ---
data/
*.log
logs/

# --- Models & audio (large, do not belong in the repository) ---
models/
*.bin
*.gguf
*.wav
*.webm
*.ogg
*.opus
*.mp3
*.m4a
# One exception, and it is a small one: the remuxer is parser code, and the only thing that
# proves it reads what a browser actually writes is a stream a browser actually wrote. Six
# seconds, twenty-two kilobytes, and it is a fixture rather than a recording of anything.
!worker/test/fixtures/*.webm

# --- OS & Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Test-Artefakte ---
playwright-report/
test-results/
.nyc_output/

# Design snapshots handed over for a ticket; not part of the build.
.design-ref/
