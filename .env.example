# ---- Hardware-Profile (nur diese 3 Zeilen wechseln) ----
# GTX 1050 (Entwicklung):      WHISPER_MODEL=small        WHISPER_COMPUTE_TYPE=int8     WHISPER_DEVICE=cuda
# RTX 4070 Ti Super (Ziel):    WHISPER_MODEL=large-v3     WHISPER_COMPUTE_TYPE=float16  WHISPER_DEVICE=cuda
# CPU-Fallback (large-Qualität, langsam, für asynchrone Jobs okay):
#                              WHISPER_MODEL=large-v3     WHISPER_COMPUTE_TYPE=int8     WHISPER_DEVICE=cpu
#
# macOS-Entwicklung (kein GPU-Zugriff in Docker-Containern auf dem Mac!):
#   Default — CPU-Image im Container (volle Stack-Parität):
#                              WHISPER_MODEL=small        WHISPER_COMPUTE_TYPE=int8     WHISPER_DEVICE=cpu
#                              WHISPER_IMAGE_TAG=latest-cpu
#   Speed-Modus — Whisper nativ mit Metal (whisper.cpp --server / mlx-whisper) auf dem Host,
#   Whisper-Container deaktivieren und im Worker setzen:
#                              WHISPER_BASE_URL=http://host.docker.internal:8080/v1
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cuda
WHISPER_IMAGE_TAG=latest-cuda

# ---- Summary-Backend (OpenAI-kompatibel, ADR-005) ----
# Heute OpenRouter:
SUMMARY_BASE_URL=https://openrouter.ai/api/v1
SUMMARY_API_KEY=sk-or-...
SUMMARY_MODEL=anbieter/modellname
# Später self-hosted, gleicher Code:
# SUMMARY_BASE_URL=http://lmstudio-host:1234/v1  (oder vLLM/Ollama)
# SUMMARY_API_KEY=unused
# SUMMARY_MODEL=lokales-modell

# ---- Infrastruktur ----
POSTGRES_USER=quorum
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=quorum
MINIO_ROOT_USER=quorum-admin
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=recordings
API_PORT=8080
MINIO_CONSOLE_PORT=9001

# ---- Auth (OIDC, Provider offen — siehe OPEN-QUESTIONS.md) ----
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=quorum
