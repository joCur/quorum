# ---- Hardware-Profile (nur diese 3 Zeilen wechseln) ----
# GTX 1050 (Entwicklung):      WHISPER_MODEL=small        WHISPER_COMPUTE_TYPE=int8     WHISPER_DEVICE=cuda
# RTX 4070 Ti Super (Ziel):    WHISPER_MODEL=large-v3     WHISPER_COMPUTE_TYPE=float16  WHISPER_DEVICE=cuda
# CPU-Fallback (large-Qualität, langsam, für asynchrone Jobs okay):
#                              WHISPER_MODEL=large-v3     WHISPER_COMPUTE_TYPE=int8     WHISPER_DEVICE=cpu
#
# macOS-Entwicklung (kein GPU-Zugriff in Docker-Containern auf dem Mac!):
#   Default — CPU-Image im Container (volle Stack-Parität):
#                              WHISPER_MODEL=small        WHISPER_COMPUTE_TYPE=int8     WHISPER_DEVICE=cpu
#                              WHISPER_IMAGE_TAG=latest-cpu
#   Speed-Modus — Whisper nativ mit Metal (whisper.cpp --server / mlx-whisper) auf dem Host,
#   Whisper-Container deaktivieren und im Worker setzen:
#                              WHISPER_BASE_URL=http://host.docker.internal:8080/v1
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cuda
WHISPER_IMAGE_TAG=latest-cuda

# ---- Transcription worker ----
# Anything speaking the OpenAI-compatible transcription API works here (ADR-005):
# the speaches container, a whisperX serving wrapper, or host-native whisper.cpp.
# WHISPER_BASE_URL=http://whisper:8000/v1
# WHISPER_API_KEY=unused
# Leave WHISPER_LANGUAGE unset to let the model detect the language.
# WHISPER_LANGUAGE=de
# WHISPER_TIMEOUT_MS=1800000
# Attempts before a retryable failure is moved to the dead-letter queue, and the
# base delay of the exponential backoff.
# WORKER_CONCURRENCY=1
# WORKER_RETRY_LIMIT=4
# WORKER_RETRY_DELAY_SECONDS=30
# WORKER_JOB_EXPIRE_SECONDS=7200

# ---- Summary backend (OpenAI-compatible chat completions, ADR-005) ----
# Switching providers is these three variables and nothing else.
SUMMARY_BASE_URL=https://openrouter.ai/api/v1
SUMMARY_API_KEY=sk-or-...
SUMMARY_MODEL=vendor/model-name
# Later, self-hosted, same code:
# SUMMARY_BASE_URL=http://lmstudio-host:1234/v1  (or vLLM/Ollama)
# SUMMARY_API_KEY=unused
# SUMMARY_MODEL=local-model
#
# Transcript budget per summary, in estimated tokens. COST-MODEL.md assumes
# 12-15k input tokens per meeting hour; a longer recording keeps its head and
# tail and has the middle elided rather than costing an unbounded amount.
# SUMMARY_MAX_INPUT_TOKENS=14000
# SUMMARY_MAX_OUTPUT_TOKENS=4000
# SUMMARY_TEMPERATURE=0.2
# SUMMARY_TIMEOUT_MS=180000
# Summaries in flight per process — network-bound, so higher than transcription.
# SUMMARY_CONCURRENCY=2
# Request response_format=json_object. Off by default: several self-hosted
# OpenAI-compatible servers reject the field, and the parser handles plain text.
# SUMMARY_JSON_MODE=false

# ---- Infrastruktur ----
POSTGRES_USER=quorum
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=quorum
MINIO_ROOT_USER=quorum-admin
MINIO_ROOT_PASSWORD=CHANGE_ME
# MinIO built-in KMS key — required so the bucket can enforce default
# server-side encryption (ADR-001). Generate with:
#   echo "quorum-key:$(head -c 32 /dev/urandom | base64)"
# Back this value up: without it the stored audio cannot be decrypted.
MINIO_KMS_SECRET_KEY=quorum-key:CHANGE_ME_BASE64_32_BYTES
S3_BUCKET=recordings
# Server-side encryption requested for every recording object (ADR-001).
# The bucket also gets default SSE from the minio-init service.
S3_SSE=AES256
API_PORT=8080
MINIO_CONSOLE_PORT=9001
# Host ports used only by docker-compose.dev.yml, the override that publishes Postgres and the
# MinIO S3 API so a server started on the host can reach them. Change them if the defaults collide
# with services already running on the machine.
POSTGRES_PORT=5432
MINIO_PORT=9000

# ---- Recording endpoint ----
# Development only: read tenant/user from the x-quorum-tenant-id / x-quorum-user-id headers on
# the recording WebSocket instead of from the access token. Off unless explicitly enabled.
RECORDING_ALLOW_HEADER_AUTH=false

# ---- Abuse and cost protection (limits and quotas) ----
# The GPU worker is the expensive attack target: every recorded hour buys GPU time and model
# tokens (~0.10 €/meeting hour, see COST-MODEL.md). The values below are the built-in defaults, so
# a fresh checkout behaves identically whether or not they are set. All of them sit far above what
# a real meeting does. In V1 they apply to every user alike; plan tiers will vary them per user.
# Seconds of RECORDED AUDIO per session, after which the server finalizes the recording itself.
# Audio time, not wall clock: a paused recording spends none of this, so a workshop with a long
# break keeps its full allowance. This is the limit that tracks cost. 14400 = 4 hours of audio.
RECORDING_MAX_RECORDED_SECONDS=14400
# Wall-clock seconds a session may stay open, pauses included. Protects the open session itself —
# socket, server state, parallel-session slot — rather than the cost of the audio, which is why it
# sits far above the recorded-duration limit. 43200 = 12 hours.
RECORDING_MAX_SESSION_LIFETIME_SECONDS=43200
# Wall-clock seconds a single pause may last. Past it the session is FINALIZED, not killed: the
# meeting is complete and playable, and picking the work back up starts a new one. 7200 = 2 hours.
RECORDING_MAX_PAUSE_SECONDS=7200
# Recording sessions one user may have open at the same time (counted per API process).
RECORDING_MAX_PARALLEL_SESSIONS=3
# Sustained chunk frames per second, per connection. A live recording sends 0.5–1.
RECORDING_MAX_CHUNKS_PER_SECOND=20
# Sustained bytes per second, per connection. Live Opus is around 4 KiB/s. 4194304 = 4 MiB.
RECORDING_MAX_BYTES_PER_SECOND=4194304
# Seconds' worth of both rates above that one connection may spend at once — the head room a
# reconnecting client needs to replay the audio it buffered while offline.
RECORDING_RATE_BURST_SECONDS=10
# Total stored audio per user, in bytes. 53687091200 = 50 GiB, roughly 3,000 hours of Opus.
QUOTA_STORAGE_BYTES=53687091200
# Seconds one user may record per calendar month (UTC). 360000 = 100 hours.
QUOTA_MONTHLY_RECORDED_SECONDS=360000
# Chunks between two usage writes during a recording, per session. Lower means a crash loses less
# of the quota accounting, higher means fewer database writes. 64 is one to two minutes of audio.
QUOTA_USAGE_FLUSH_CHUNKS=64
# REST requests one user may make per window, across the whole API.
API_RATE_LIMIT_MAX=300
# Length of that window, in seconds.
API_RATE_LIMIT_WINDOW_SECONDS=60
# Requests to the summary regenerate route per window, per user. Its own, much smaller number
# because every accepted request there buys a model call.
API_RATE_LIMIT_SUMMARY_MAX=10

# ---- Auth (OIDC via Keycloak, ADR-006 §7) ----
# Keycloak runs inside the compose stack and imports infra/keycloak/realm-quorum.json on first
# start, so `docker compose up` gives a working login with no clicking in the admin console.
KEYCLOAK_VERSION=26.5
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Keycloak's own logical database on the shared Postgres instance (no extra container).
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME
# Origin at which browsers reach Keycloak; ends up in the `iss` claim of the tokens.
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Server-side token validation. The internal issuer is used for discovery/JWKS inside the compose
# network; the public issuer is what browser-obtained tokens actually carry. Both are accepted as
# `iss`. When running the server outside compose, point both at the public URL.
OIDC_ISSUER_URL=http://keycloak:8080/realms/quorum
OIDC_PUBLIC_ISSUER_URL=http://localhost:8081/realms/quorum
# Public PWA client — Authorization Code + PKCE, no secret.
OIDC_CLIENT_ID=quorum-pwa
# Audience the API requires in the access token (added by the token mappers on the realm client).
OIDC_AUDIENCE=quorum-api
# Token claim carrying the tenant. Every data object is tenant/user scoped (ADR-001).
OIDC_TENANT_CLAIM=tenant_id

# ---- Server (@quorum/server) ----
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# =============================================================================================
# ---- Release deployment (docker-compose.release.yml) ----
#
# Everything above configures the development stack. The variables below are read only by
# docker-compose.release.yml, which runs published images instead of building from the working
# tree. docs/deployment.md walks a fresh host through the whole setup.
#
# MANDATORY — the `preflight` service refuses to start the stack while any of these is missing or
# still holds a placeholder value:
#
#   QUORUM_VERSION            KEYCLOAK_ADMIN_PASSWORD   MINIO_ROOT_USER
#   POSTGRES_USER             KEYCLOAK_PUBLIC_URL       MINIO_ROOT_PASSWORD
#   POSTGRES_PASSWORD         QUORUM_PUBLIC_URL         MINIO_KMS_SECRET_KEY
#   POSTGRES_DB               S3_BUCKET                 SUMMARY_BASE_URL
#   KEYCLOAK_DB_PASSWORD      SUMMARY_API_KEY           SUMMARY_MODEL
#
# Passwords must be at least 16 characters. Generate each one separately:
#   openssl rand -hex 24
# Hex rather than base64 on purpose: POSTGRES_PASSWORD is embedded in the DATABASE_URL the
# compose file assembles, and a "/" or "@" in it silently truncates that URL. The preflight
# rejects a Postgres password containing a URL-reserved character for exactly that reason.
# =============================================================================================

# The release to run. No default anywhere in the compose file: pinning is the point, and
# `docker compose pull` on a floating tag changes what runs without anyone deciding to.
# QUORUM_VERSION=1.0.0
# Where the images live. Change it only when mirroring them into another registry.
# QUORUM_IMAGE_REGISTRY=ghcr.io/jocur

# Origins as browsers see them. Both must be https:// and neither may be a loopback address —
# the preflight rejects both. TLS is terminated in the reverse proxy in front of this stack.
# QUORUM_PUBLIC_URL=https://quorum.example.com
# KEYCLOAK_PUBLIC_URL=https://auth.example.com

# Address the API and Keycloak are published on. Loopback by default, because the reverse proxy
# runs on the host and nothing else should reach plain HTTP. Postgres, the MinIO S3 API and the
# MinIO console are not published at all in the release stack, at any address.
# BIND_ADDRESS=127.0.0.1

# The realm the production deployment uses. It is created explicitly — the committed
# infra/keycloak/realm-quorum.json is a development fixture and is NOT imported by the release
# stack. See docs/deployment.md.
# KEYCLOAK_REALM=quorum

# Per-container resource limits. The defaults suit a single-host deployment; raise them on a
# bigger machine rather than removing them.
# API_CPU_LIMIT=2            API_MEMORY_LIMIT=1g
# WORKER_CPU_LIMIT=2         WORKER_MEMORY_LIMIT=2g
# KEYCLOAK_CPU_LIMIT=2       KEYCLOAK_MEMORY_LIMIT=1g
# POSTGRES_CPU_LIMIT=2       POSTGRES_MEMORY_LIMIT=2g
# MINIO_CPU_LIMIT=2          MINIO_MEMORY_LIMIT=2g
# WHISPER_CPU_LIMIT=4        WHISPER_MEMORY_LIMIT=8g

# Third-party image tags, pinned per deployment.
# MINIO_VERSION=latest
# MINIO_MC_VERSION=latest

# Only needed with the opt-in `monitoring` profile. Grafana has no default password in the
# release stack, so the profile refuses to start without this.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
