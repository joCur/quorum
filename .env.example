# ---- Hardware-Profile (nur diese 3 Zeilen wechseln) ----
# GTX 1050 (Entwicklung):      WHISPER_MODEL=small        WHISPER_COMPUTE_TYPE=int8     WHISPER_DEVICE=cuda
# RTX 4070 Ti Super (Ziel):    WHISPER_MODEL=large-v3     WHISPER_COMPUTE_TYPE=float16  WHISPER_DEVICE=cuda
# CPU-Fallback (large-Qualität, langsam, für asynchrone Jobs okay):
#                              WHISPER_MODEL=large-v3     WHISPER_COMPUTE_TYPE=int8     WHISPER_DEVICE=cpu
#
# macOS-Entwicklung (kein GPU-Zugriff in Docker-Containern auf dem Mac!):
#   Default — CPU-Image im Container (volle Stack-Parität):
#                              WHISPER_MODEL=small        WHISPER_COMPUTE_TYPE=int8     WHISPER_DEVICE=cpu
#                              WHISPER_IMAGE_TAG=latest-cpu
#   Speed-Modus — Whisper nativ mit Metal (whisper.cpp --server / mlx-whisper) auf dem Host,
#   Whisper-Container deaktivieren und im Worker setzen:
#                              WHISPER_BASE_URL=http://host.docker.internal:8080/v1
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cuda
WHISPER_IMAGE_TAG=latest-cuda

# ---- Transcription worker ----
# Anything speaking the OpenAI-compatible transcription API works here (ADR-005):
# the speaches container, a whisperX serving wrapper, or host-native whisper.cpp.
# WHISPER_BASE_URL=http://whisper:8000/v1
# WHISPER_API_KEY=unused
# Leave WHISPER_LANGUAGE unset to let the model detect the language.
# WHISPER_LANGUAGE=de
# WHISPER_TIMEOUT_MS=1800000
# Attempts before a retryable failure is moved to the dead-letter queue, and the
# base delay of the exponential backoff.
# WORKER_CONCURRENCY=1
# WORKER_RETRY_LIMIT=4
# WORKER_RETRY_DELAY_SECONDS=30
# WORKER_JOB_EXPIRE_SECONDS=7200

# ---- Summary backend (OpenAI-compatible chat completions, ADR-005) ----
# Switching providers is these three variables and nothing else.
SUMMARY_BASE_URL=https://openrouter.ai/api/v1
SUMMARY_API_KEY=sk-or-...
SUMMARY_MODEL=vendor/model-name
# Later, self-hosted, same code:
# SUMMARY_BASE_URL=http://lmstudio-host:1234/v1  (or vLLM/Ollama)
# SUMMARY_API_KEY=unused
# SUMMARY_MODEL=local-model
#
# Transcript budget per summary, in estimated tokens. COST-MODEL.md assumes
# 12-15k input tokens per meeting hour; a longer recording keeps its head and
# tail and has the middle elided rather than costing an unbounded amount.
# SUMMARY_MAX_INPUT_TOKENS=14000
# SUMMARY_MAX_OUTPUT_TOKENS=4000
# SUMMARY_TEMPERATURE=0.2
# SUMMARY_TIMEOUT_MS=180000
# Summaries in flight per process — network-bound, so higher than transcription.
# SUMMARY_CONCURRENCY=2
# Request response_format=json_object. Off by default: several self-hosted
# OpenAI-compatible servers reject the field, and the parser handles plain text.
# SUMMARY_JSON_MODE=false

# ---- Infrastruktur ----
POSTGRES_USER=quorum
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=quorum
MINIO_ROOT_USER=quorum-admin
MINIO_ROOT_PASSWORD=CHANGE_ME
# MinIO built-in KMS key — required so the bucket can enforce default
# server-side encryption (ADR-001). Generate with:
#   echo "quorum-key:$(head -c 32 /dev/urandom | base64)"
# Back this value up: without it the stored audio cannot be decrypted.
MINIO_KMS_SECRET_KEY=quorum-key:CHANGE_ME_BASE64_32_BYTES
S3_BUCKET=recordings
# Server-side encryption requested for every recording object (ADR-001).
# The bucket also gets default SSE from the minio-init service.
S3_SSE=AES256
API_PORT=8080
MINIO_CONSOLE_PORT=9001
# Host ports used only by docker-compose.dev.yml, the override that publishes Postgres and the
# MinIO S3 API so a server started on the host can reach them. Change them if the defaults collide
# with services already running on the machine.
POSTGRES_PORT=5432
MINIO_PORT=9000

# ---- Recording endpoint ----
# Development only: read tenant/user from the x-quorum-tenant-id / x-quorum-user-id headers on
# the recording WebSocket instead of from the access token. Off unless explicitly enabled.
RECORDING_ALLOW_HEADER_AUTH=false

# ---- Auth (OIDC via Keycloak, ADR-006 §7) ----
# Keycloak runs inside the compose stack and imports infra/keycloak/realm-quorum.json on first
# start, so `docker compose up` gives a working login with no clicking in the admin console.
KEYCLOAK_VERSION=26.5
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Keycloak's own logical database on the shared Postgres instance (no extra container).
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME
# Origin at which browsers reach Keycloak; ends up in the `iss` claim of the tokens.
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Server-side token validation. The internal issuer is used for discovery/JWKS inside the compose
# network; the public issuer is what browser-obtained tokens actually carry. Both are accepted as
# `iss`. When running the server outside compose, point both at the public URL.
OIDC_ISSUER_URL=http://keycloak:8080/realms/quorum
OIDC_PUBLIC_ISSUER_URL=http://localhost:8081/realms/quorum
# Public PWA client — Authorization Code + PKCE, no secret.
OIDC_CLIENT_ID=quorum-pwa
# Audience the API requires in the access token (added by the token mappers on the realm client).
OIDC_AUDIENCE=quorum-api
# Token claim carrying the tenant. Every data object is tenant/user scoped (ADR-001).
OIDC_TENANT_CLAIM=tenant_id

# ---- Server (@quorum/server) ----
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
